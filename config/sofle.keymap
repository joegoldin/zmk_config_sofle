#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&nice_view_spi { cs-gpios = <&pro_micro 0 GPIO_ACTIVE_HIGH>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Layer 0";

            // ------------------------------------------------------------------------------------------------------------
            // | GESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | MINUS |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   \   |
            // | LCTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | USER  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               |  [  | GUI  | ALT  | MO(1)|  SPACE |  | BKSPC | ENTER| RALT  | RGUI  |   ]  |

            bindings = <
&gresc     &kp N1  &kp N2    &kp N3    &kp N4    &kp N5                          &kp N6   &kp N7    &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W     &kp E     &kp R     &kp T                           &kp Y    &kp U     &kp I      &kp O     &kp P     &kp BSLH
&kp LCTRL  &kp A   &kp S     &kp D     &kp F     &kp G                           &kp H    &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X     &kp C     &kp V     &kp B   &kp C_MUTE    &trans    &kp N    &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                   &kp LBKT  &kp LGUI  &kp LALT  &mo 1   &kp SPACE     &kp BSPC  &kp RET  &kp RALT  &kp RGUI   &kp RBKT
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        lower_layer {
            display-name = "Layer 1";

            // ------------------------------------------------------------------------------------------------------------
            // |  F12  |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |     |     |      |      |      |                   |  -   |   =   |  UP   |      |       |       |
            // |       |     |     |      |      |      |                   |  _   | LEFT  | DOWN  | RIGHT|       |       |
            // |       |  (  |     |      |      |      |        |  |       |  *   |       |       |      |   )   |       |
            //               |  (  |      |      |      | S-ENTR |  |  DEL  | SHFT |       |       |   )  |

            bindings = <
&kp F12    &kp F1    &kp F2    &kp F3  &kp F4  &kp F5                     &kp F6           &kp F7     &kp F8    &kp F9     &kp F10   &kp F11
&kp GRAVE  &trans    &trans    &trans  &trans  &trans                     &kp MINUS        &kp EQUAL  &kp UP    &trans     &trans    &trans
&trans     &trans    &trans    &trans  &trans  &trans                     &kp UNDER        &kp LEFT   &kp DOWN  &kp RIGHT  &trans    &trans
&trans     &kp LPAR  &trans    &trans  &trans  &trans  &trans    &trans   &kp KP_MULTIPLY  &trans     &trans    &trans     &kp RPAR  &trans
                     &kp LPAR  &trans  &trans  &trans  &trans    &kp DEL  &kp LS(RET)      &mo 2      &trans    &kp RPAR
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };

        raise_layer {
            display-name = "Layer 2";

            // ------------------------------------------------------------------------------------------------------------
            // |BTCLR| BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |     |      |      |       |       |      |                | PGUP | HOME |  UP   | END  | PSCRN |       |
            // |     |      |      |       |       |      |                | PGDN | LEFT | DOWN  | RIGHT|  INS  |       |
            // |     |      |      |       |       |      |      |  |      |      |      |       |      |       |       |
            //              |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &rgb_ug RGB_TOG  &rgb_ug RGB_COLOR_HSB(0,100,38)  &rgb_ug RGB_EFF  &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &trans
&trans      &trans        &trans        &trans        &trans        &trans                          &kp PG_UP        &kp HOME                         &kp UP           &kp END          &kp PSCRN        &trans
&trans      &trans        &trans        &trans        &trans        &trans                          &kp PG_DN        &kp LEFT                         &kp DOWN         &kp RIGHT        &trans           &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans           &trans                           &trans           &trans           &trans           &trans
                          &trans        &trans        &trans        &trans        &trans    &trans  &trans           &trans                           &trans           &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PAGE_UP PAGE_DOWN>;
        };
    };
};
